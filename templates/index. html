<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>KDP Book Generator</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <main class="container">
    <h1>KDP Book Generator</h1>
    <p>Create your book interior + cover instantly.</p>

    <form method="POST" action="/generate">
      <label>Book Title
        <input name="title" required>
      </label>

      <label>Author
        <input name="author">
      </label>

      <label>Pages
        <input type="number" name="pages" value="24" min="2">
      </label>

      <label>Sample Text
        <textarea name="sample_text" rows="5"></textarea>
      </label>

      <button type="submit">Generate ZIP</button>
    </form>

    <footer><small>Hosted on Render</small></footer>
  </main>
</body>
</html>

body{background:#f4f6f9;margin:0;font-family:Arial, sans-serif;}
.container{max-width:700px;margin:40px auto;padding:25px;background:#fff;border-radius:10px;box-shadow:0 3px 15px rgba(0,0,0,0.1);}
h1{margin-top:0;}
label{display:block;margin-bottom:15px;}
input,textarea{width:100%;padding:10px;border:1px solid #ccc;border-radius:5px;margin-top:5px;}
button{background:#0066ff;color:#fff;border:0;padding:12px 18px;border-radius:8px;font-size:15px;cursor:pointer;}
button:hover{background:#0056d6;}
footer{text-align:center;margin-top:20px;color:#666;}
